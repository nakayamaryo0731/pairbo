{
  "name": "pairbo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run convex/**/*.integration.test.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/localizations": "^4.23.0",
    "@clerk/nextjs": "^7.9.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/turbopack": "^9.5.13",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@next/bundle-analyzer": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.61",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "browserslist@<4.28.7": "^4.28.7",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8"
    }
  }
}
